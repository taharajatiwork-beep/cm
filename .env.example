# Application
APP_NAME=cm
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Postgres + pgvector image in docker-compose)
DATABASE_URL=postgresql+asyncpg://cm:cm@localhost:5432/cm

# --- Production deployment (docker-compose.prod.yml reads these) ---
# These have no defaults on purpose: compose fails fast if one is missing,
# rather than booting a service with a well-known password.
# Generate real values, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_USER=cm
POSTGRES_PASSWORD=
POSTGRES_DB=cm
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
GF_SECURITY_ADMIN_PASSWORD=
# Passphrase that encrypts each database dump (AES256, symmetric GPG).
# Losing it means losing every backup — store it in your password manager.
BACKUP_PASSPHRASE=
BACKUP_RETENTION_DAYS=30

# Redis (reserved for later workers)
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO

# Telegram adapter (optional — leave token empty / mode=off for tests)
# TELEGRAM_MODE=off | polling | webhook
TELEGRAM_MODE=off
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=change-me-if-you-enable-webhook-mode
TELEGRAM_WEBHOOK_URL=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_LINK_CODE_TTL_MINUTES=10
WEB_APP_BASE_URL=http://localhost:5173

# Optional Bale (Telegram-compatible). Same modes as Telegram.
BALE_MODE=off
BALE_BOT_TOKEN=
BALE_BOT_USERNAME=
BALE_API_BASE=https://tapi.bale.ai
BALE_WEBHOOK_SECRET=
BALE_WEBHOOK_URL=

# Embeddings / RAG (hash = local deterministic; openai needs API key)
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=hash-v1
EMBEDDING_DIMS=64
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://api.openai.com/v1

# Assignment engine
ASSIGNMENT_AUTO_ASSIGN_ENABLED=false

# LLM via 9Router (OpenAI-compatible). Default in code is rules (no network).
# LLM_PROVIDER=9router|openai|rules|fake
LLM_PROVIDER=rules
LLM_API_BASE=http://localhost:20128/v1
LLM_API_KEY=
# Use your combo name from 9Router dashboard/combos (e.g. taha)
LLM_MODEL=taha

# Divar assisted pilot
DIVAR_MODE=fake
DIVAR_API_BASE=http://localhost:3000
DIVAR_API_TOKEN=tok-admin-xyz
DIVAR_AUTO_PREPARE=true

ENTERPRISE (on-prem). Turn these on in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
# true in production — the startup guard refuses to boot without it.
# Keep it false for plain-HTTP localhost development.
COOKIE_SECURE=false
UPLOAD_MAX_BYTES=5000000
FILE_STORAGE_DIR=var/files
# external in production: the guard refuses to boot with `embedded`.
WORKER_MODE=embedded
SLA_USE_BUSINESS_CALENDAR=false
SLA_CHAIN_ESCALATION=false
LDAP_ENABLED=false
LDAP_URL=
SMS_PROVIDER=fake
SMTP_HOST=
VOIP_MODE=fake
ERP_MODE=fake
AI_DAILY_TOKEN_QUOTA=200000
REQUIRE_HUMAN_APPROVAL_FOR_SENSITIVE_AI=false

# Performance-marketing Google Sheets sync (button in the app — not a cron).
# Repo-root .env is enough: the API loads ../.env when started from backend/,
# and docker-compose env_file injects this same file. Do not commit the JSON key.
# Point CREDENTIALS_FILE at a path the API process can read (mount it in Docker).
PERF_SHEETS_CREDENTIALS_FILE=
# Sotoudeh workbook tabs: SMS, Social, Leads, Costs, Report
PERF_SHEETS_SPREADSHEET_ID=
# Source workbooks. Sync writes CM rows into a matching tab, or creates CM Costs / CM Campaigns / CM Report.
PERF_SHEETS_COST_TRACKING_ID=
PERF_SHEETS_REGISTER_CAMPAIGN_ID=
PERF_SHEETS_REPORTER_ID=
