# From repo root after pushing main:
#   git archive -o cm-update.tar.gz HEAD
#   uv run python deploy/remote-update.py
#
# Docker path (only if .env + CORS_ORIGINS are set on the host):
#   cd ~/CM && docker compose -f docker-compose.prod.yml up -d --build
