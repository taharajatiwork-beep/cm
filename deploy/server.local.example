CM_SERVER_USER=didar
CM_SERVER_PASSWORD=
CM_SERVER_PROJECT_DIR=CM

# Internal server (didar@192.168.17.4): app runs from ~/CM via cm-apply-update.sh
# (uvicorn :8001 + vite :5173), not docker-compose.prod, when GitHub pull is unavailable.
